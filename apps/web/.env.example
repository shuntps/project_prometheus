# Template for a direct local run of this application. Values are fictitious.
# Copy it to a local, untracked file; never put a real value in this one.

# Required. The public name. It is read on the server and rendered into the
# HTML on purpose; it comes from here rather than from a literal in a component.
# It has no production default and is not a client environment variable.
SITE_NAME=Example Platform

# Optional server-only origin used by Next.js to rewrite /api/* requests.
# Docker Compose supplies its own internal origin for the web container.
# CORE_API_INTERNAL_ORIGIN=http://127.0.0.1:8080
