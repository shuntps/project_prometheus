*.sql.gz
*.mp4
*.webm
*.m3u8
*.mkv
*.flv
# A bare `*.ts` is deliberately absent: it would match every TypeScript source
# file. Media segments are covered by the ignored data directory.

# =============================================================================
# Logs, coverage and test output
# =============================================================================
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
