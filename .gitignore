# =============================================================================
# Paths hidden by the owner
# Set by the owner before making this repository public. Later blocks are
# additions; they do not relax anything in this one.
# =============================================================================
AGENTS.md
CLAUDE.md
ROADMAP.md
docs/
design/
audit/

# Re-including a single file from an ignored directory
# Git does not descend into an excluded directory, so `!docs/README.md` alone
# has no effect. The directory has to be un-ignored first, then its contents
# re-excluded:
#     docs/
#     !docs/
#     docs/*
#     !docs/README.md

