# Example configuration for the Core API. Values are fictitious placeholders.
# Copy to a local, untracked file and set real values there. Never commit secrets.

# Required. One of: development, staging, production.
APP_ENV=development

# Optional. One of: debug, info, warn, error. Defaults to info.
LOG_LEVEL=info

# Optional. host:port the HTTP server binds to. Defaults to :8080.
HTTP_ADDRESS=:8080

# Optional Go durations. Must be greater than zero when set.
HTTP_READ_TIMEOUT=10s
HTTP_WRITE_TIMEOUT=15s
HTTP_IDLE_TIMEOUT=60s
SHUTDOWN_TIMEOUT=15s

# Per-instance HTTP abuse policy. This is a local defence, not a distributed limit.
# The values below are DEVELOPMENT values and are NOT a production policy.
# Staging and production must set all three explicitly; a missing, zero or
# invalid policy refuses startup. There is no switch to disable the control.
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW=1m
# One of: fixed_window, sliding_window.
RATE_LIMIT_ALGORITHM=fixed_window
# Required in staging and production. One of: direct, behind_proxy.
# direct       : the key is the direct peer address; no proxy header is read.
# behind_proxy : an allowlist and a proxy header are both required, and the
#                forwarded chain is walked right to left with trusted hops
#                stripped. The upstream proxy must OVERWRITE the chosen header
#                rather than forward a client-supplied value.
NETWORK_MODE=direct

# Required when NETWORK_MODE is behind_proxy, forbidden otherwise.
# One of: X-Forwarded-For, X-Real-Ip.
RATE_LIMIT_PROXY_HEADER=

# Required when NETWORK_MODE is behind_proxy, forbidden otherwise.
# Comma-separated addresses or CIDR blocks.
RATE_LIMIT_TRUSTED_PROXIES=



# Required in every environment; the service has no mode that runs without a
# database. Full URL with user and password, and no query parameter is accepted.
DATABASE_URL=postgres://core_api:local-development-only@127.0.0.1:5432/core_api

# The value is a secret and never reaches a log or an error. A libpq variable
# carrying a non-empty value refuses startup.

# Absent, or exactly the empty string, does not influence the driver. Spaces are
# a value, so they are refused. A non-empty one redirects it or reads local files.

# Required in staging and production, where only verify-ca and verify-full pass;
# the rule keys on APP_ENV, not on where the database actually is.
DATABASE_TLS_MODE=disable

# Required whenever the mode authenticates: "system" for the host pool, or an
# absolute path. Nothing is inherited from the account running the process.
DATABASE_TLS_ROOT_CERT=

# "system" may not be paired with verify-ca: the driver rewrites the mode to
# verify-full when the host pool is selected.

# With "system", SSL_CERT_FILE and SSL_CERT_DIR must carry no value: they belong
# to Go, and a non-empty one replaces the certificate authorities.

# Absent, or exactly the empty string, points Go at no other file or directory.
# A value of spaces is a path, so it stays forbidden.

# The base image ships a non-empty SSL_CERT_FILE. Choosing "system" therefore
# means overriding it with an empty string in the deployment.

# Which authenticated mode is mandated, which trust source, the channel-binding
# policy, the permitted authentication methods and rotation are not settled here.

# Optional pool bounds. Connection counts are integers; the rest are Go
# durations. Every value is bounded and refuses startup when out of range.
DATABASE_MAX_CONNS=8
DATABASE_MIN_CONNS=0
DATABASE_MAX_CONN_LIFETIME=1h
DATABASE_MAX_CONN_IDLE_TIME=30m

# Optional bounds on the startup connection and on each readiness check, so a
# probe never hangs on an unresponsive server.
DATABASE_CONNECT_TIMEOUT=5s
DATABASE_HEALTH_CHECK_TIMEOUT=2s

# Argon2id cost. Required in staging and production, where it must be calibrated
# on the real host. It may be raised above the floor below, never lowered.
PASSWORD_ARGON2_MEMORY_KIB=19456
PASSWORD_ARGON2_ITERATIONS=2
PASSWORD_ARGON2_LANES=1

# Minimum password length in Unicode code points, applied when a password is
# created or changed. It may be raised, never set below 15.

# NIST requires 15 for a password used as the only factor; 8 becomes permissible
# only once a second factor is genuinely required, which is not the case today.
PASSWORD_MIN_LENGTH=15

# No composition rule is applied and nothing is truncated. A separate 4096-byte
# limit bounds resources and is not a length policy.

# Session expiry. The two bounds are distinct: idle ends an unused session, and
# absolute ends every session however active it has been.
SESSION_ABSOLUTE_LIFETIME=12h
SESSION_IDLE_LIFETIME=30m
